# AVS field file
#
# AutoDock Atomic Affinity and Electrostatic Grids
#
# Created by /usr/bin/autogrid4.
#
#SPACING 0.375
#NELEMENTS 60 60 60
#CENTER -2.040 2.030 9.290
#MACROMOLECULE receptor.mem.pdbqt
#GRID_PARAMETER_FILE mem.gpf
#
ndim=3			# number of dimensions in the field
dim1=61			# number of x-elements
dim2=61			# number of y-elements
dim3=61			# number of z-elements
nspace=3		# number of physical coordinates per point
veclen=3		# number of affinity values at each point
data=float		# data type (byte, integer, float, double)
field=uniform		# field type (uniform, rectilinear, irregular)
coord 1 file=receptor.mem.maps.xyz filetype=ascii offset=0
coord 2 file=receptor.mem.maps.xyz filetype=ascii offset=2
coord 3 file=receptor.mem.maps.xyz filetype=ascii offset=4
label=C-affinity	# component label for variable 1
label=Electrostatics	# component label for variable 1
label=Desolvation	# component label for variable 2
#
# location of affinity grid files and how to read them
#
variable 1 file=receptor.mem.C.map filetype=ascii skip=6
variable 2 file=receptor.mem.e.map filetype=ascii skip=6
variable 3 file=receptor.mem.d.map filetype=ascii skip=6
