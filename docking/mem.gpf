npts 60 60 60                        # num.grid points in xyz
gridfld receptor.mem.maps.fld        # grid_data_file
spacing 0.375                        # spacing(A)
receptor_types A C HD N NA OA P      # receptor atom types
ligand_types C                       # ligand atom types
receptor receptor.mem.pdbqt          # macromolecule
gridcenter -2.04 2.03 9.29           # xyz-coordinates or auto
smooth 0.5                           # store minimum energy w/in rad(A)
map receptor.mem.C.map               # atom-specific affinity map
elecmap receptor.mem.e.map           # electrostatic potential map
dsolvmap receptor.mem.d.map              # desolvation potential map
dielectric -0.1465                   # <0, AD4 distance-dep.diel;>0, constant
